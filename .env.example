APP_ENV=development
APP_NAME="World Ticket API"
APP_VERSION=1.0.0
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

SECRET_KEY=change_me_to_a_random_64_char_hex_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/worldticket_db
SYNC_DATABASE_URL=postgresql://user:password@localhost:5432/worldticket_db

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Optional — only required if using Cloudinary for image uploads
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Stripe — secret key is backend-only; publishable key is frontend-only (not needed here)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
FRONTEND_URL=https://ticketapoint.com

RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=10/minute

DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Initial admin account created on first startup
INITIAL_ADMIN_EMAIL=admin@worldticket.com
INITIAL_ADMIN_PASSWORD=change_me_admin_password
INITIAL_ADMIN_NAME="Super Admin"
